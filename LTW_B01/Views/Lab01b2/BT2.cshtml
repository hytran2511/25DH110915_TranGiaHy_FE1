@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <p>Hình 1</p>
    <table border="1" width="300" height="200">
        <tr height="40">
            <td colspan="2">Top</td>
        </tr>

        <tr>
            <td width="60">Left</td>
            <td>Right</td>
        </tr>
    </table>

    <p>Hình 2</p>
    <table border="1" width="300" height="200">
        <tr height="40">
            <td colspan="2">Top</td>
        </tr>

        <tr>
            <td>Left</td>
            <td width="60">Right</td>
        </tr>
    </table>

    <p>Hình 3</p>
    <table border="1" width="300" height="200">
        <tr height="40">
            <td colspan="2">Top</td>
        </tr>

        <tr>
            <td>Left</td>
            <td width="60">Right</td>
        </tr>

        <tr height="40">
            <td colspan="2">Bottom</td>
        </tr>
    </table>

    <p>Hình 4</p>
    <table border="1" width="300" height="200">
        <tr height="30">
            <td>Top 1</td>
        </tr>

        <tr height="30">
            <td>Top 2</td>
        </tr>

        <tr>
            <td>
                <table border="1" width="100%" height="100%">
                    <tr>
                        <td width="60">Left</td>
                        <td>Right</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <p>Hình 5</p>
    <table border="1" width="300" height="200">
        <tr height="40">
            <td colspan="2" width="150">Top Left</td>
            <td colspan="2">Top Right</td>
        </tr>

        <tr height="20">
            <td colspan="4">Middle</td>
        </tr>
        <tr>
            <td width="75">Left</td>
            <td colspan="3" width="225">Right</td>
        </tr>
    </table>

    <p>Hình 6</p>
    <table border="1" width="300" height="200">
        <tr height="40">
            <td colspan="2" ="120">Top Left</td>
            <td colspan="2">Top Right</td>
        </tr>
        <tr>
            <td width="60">Left</td>
            <td colspan="2">Center</td>
            <td width="60">Right</td>
        </tr>
        <tr height="40">
            <td colspan="4">Bottom</td>
        </tr>
    </table>
</body>
</html>
