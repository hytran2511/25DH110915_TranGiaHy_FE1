@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <h1>NHẬP THÔNG TIN SINH VIÊN</h1>

    <form action="https://www.google.com" method="POST">
        <table border="1">
            <tr>
                <td rowspan="3">
                    <img src="img/hinh01.jpg" width="120" alt="Avatar" />
                </td>
                <td>HỌ VÀ TÊN:</td>
                <td colspan="3"><input type="text" /></td>
            </tr>
            <tr>
                <td>MÃ SỐ SINH VIÊN:</td>
                <td colspan="3"><input type="text" /></td>
            </tr>
            <tr>
                <td>NGÀY SINH:</td>
                <td colspan="3"><input type="date" /></td>
            </tr>
            <tr>
                <td colspan="2">CHUYÊN NGÀNH:</td>
                <td colspan="3">
                    <input type="radio" name="nganh" /> CNPM
                    <input type="radio" name="nganh" /> HTTT
                    <input type="radio" name="nganh" /> AN NINH MẠNG
                </td>
            </tr>
            <tr>
                <td colspan="2">SỞ THÍCH:</td>
                <td colspan="3">
                    <input type="checkbox" /> VIẾT CHƯƠNG TRÌNH<br />
                    <input type="checkbox" /> PHÂN TÍCH CSDL<br />
                    <input type="checkbox" /> XÂY DỰNG SƠ ĐỒ MẠNG<br />
                </td>
            </tr>
            <tr>
                <td>MÀU SẮC YÊU THÍCH:</td>
                <td><input type="color"</td>
                <td>HÌNH ĐẠI DIỆN:</td>
                <td colspan="2"><input type="file" /></td>
            </tr>
            <tr>
                <td colspan="2">TÊN ĐĂNG NHẬP WEB TRƯỜNG:</t>
                <td colspan="3"><input type="text" /></td>
            </tr>
            <tr>
                <td colspan="2">MẬT KHẨU ĐĂNG NHẬP WEB TRƯỜNG:</td>
                <td colspan="3"<input type="password" value="="12345678" /></td>
            </tr>
            <tr>
                <td colspan="5" align="center">
                    <input type="submit" value="Gửi dữ liệu về máy chủ" />
                </td>
            </tr>
        </table>
    </form>
</body>
</html>
